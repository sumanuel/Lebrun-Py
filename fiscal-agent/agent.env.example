# URL del servidor donde corre Lebrun-Py (FastAPI)
LEBRUN_SERVER_URL=http://127.0.0.1:8000

# Debe ser igual a LEBRUN_FISCAL_AGENT_TOKEN del servidor
LEBRUN_FISCAL_AGENT_TOKEN=change-me

# (Opcional) Filtrar por caja específica (recomendado: un servicio por caja/PC)
LEBRUN_FISCAL_CAJA=01

# Polling
LEBRUN_FISCAL_POLL_SECONDS=2

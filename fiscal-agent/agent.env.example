# URL del servidor donde corre Lebrun-Py (FastAPI)
LEBRUN_SERVER_URL=http://127.0.0.1:8000

# Debe ser igual a LEBRUN_FISCAL_AGENT_TOKEN del servidor
LEBRUN_FISCAL_AGENT_TOKEN=change-me

# (Opcional) Filtrar por caja específica (recomendado: un servicio por caja/PC)
LEBRUN_FISCAL_CAJA=01

# Polling
LEBRUN_FISCAL_POLL_SECONDS=2

# --- TFHKA / Impresora fiscal ---
# Puerto COM donde está conectada la impresora fiscal (ej: COM3)
LEBRUN_FISCAL_COM_PORT=COM3

# Ruta al DLL del SDK TFHKA (TfhkaNet.dll) en esta PC
# Sugerencia: copiar el DLL a una carpeta fija, por ejemplo:
# C:\Lebrun\tfhka\TfhkaNet.dll
LEBRUN_TFHKA_DLL_PATH=C:\Lebrun\tfhka\TfhkaNet.dll

# Carpeta donde la app guarda snapshots (factura_<id>.json)
# Debe apuntar a la misma ruta configurada en el servidor (LEBRUN_INVOICES_PATH)
LEBRUN_INVOICES_PATH=D:\Mis proyectos\Lebrun-Py\data\invoices

# (Opcional) Forzar modo simulación/stub (no toca impresora): stub
# LEBRUN_FISCAL_MODE=stub

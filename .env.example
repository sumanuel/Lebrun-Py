# DB (equivalente a App.config)
LEBRUN_DB_HOST=localhost
LEBRUN_DB_PORT=3306
LEBRUN_DB_USER=root
LEBRUN_DB_PASSWORD=

# Nombres de esquemas
LEBRUN_DB_SYSADM=sisadm
LEBRUN_DB_SYSCONF=sysconf
LEBRUN_DB_SYSCONTA_PREFIX=sysconta

# Sesiones
SECRET_KEY=change-me-in-dev

# Fiscal Agent (servicio Windows)
# Token compartido entre el backend y el agente (se manda en header X-Agent-Token)
LEBRUN_FISCAL_AGENT_TOKEN=change-me

# Ruta de almacenamiento de jobs fiscales en el servidor
LEBRUN_FISCAL_JOBS_PATH=

# Configuración DEMO (Servidor central en LAN)

# DB
LEBRUN_DB_HOST=localhost
LEBRUN_DB_PORT=3306
LEBRUN_DB_USER=root
LEBRUN_DB_PASSWORD=

LEBRUN_DB_SYSADM=sisadm
LEBRUN_DB_SYSCONF=sysconf
LEBRUN_DB_SYSCONTA_PREFIX=sysconta

# Sesiones
SECRET_KEY=change-me-in-dev

# Fiscal Agent
LEBRUN_FISCAL_AGENT_TOKEN=change-me
# (Opcional) Ruta donde se guardan jobs fiscales en el servidor
# LEBRUN_FISCAL_JOBS_PATH=D:\Lebrun\data\fiscal_jobs.json

# Uvicorn (para que sea accesible por LAN)
LEBRUN_UVICORN_HOST=0.0.0.0
LEBRUN_UVICORN_PORT=8000
